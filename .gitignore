# and store.js replays that file through processDownloadJob at boot.
server/data/
server/downloads
server/dtn_spool/
server/vault_data
server/users.json
server/secrets.json
server/tls-cert.json
server/thumbnails/
server/kiwix-serve.exe

# server/config.json is a per-machine file; config.example.json is the template.
server/config.json

# ── Secrets ──
.env
.env.*
*.jks

